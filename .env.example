# Authorize.net (merchant account via Chase). Copy to .env.local and fill in.
# Leave the login ID and transaction key empty to use the built-in stub gateway.
# Server-only: never prefix these with NEXT_PUBLIC_.
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
# Verifies webhook X-ANET-Signature (HMAC-SHA512). Not used until webhooks are added.
AUTHORIZE_NET_SIGNATURE_KEY=
# sandbox | production
AUTHORIZE_NET_ENV=
# Fail closed: in production (NODE_ENV or VERCEL_ENV = production, which includes `next start`
# and Vercel production deploys) the stub is refused when the keys above are empty, and every
# payment route answers 503. Set to 1 only for a demo deployment that should use the stub.
PAYMENTS_ALLOW_STUB=
