# Authorize.net (merchant account via Chase). Copy to .env.local and fill in.
# Leave the login ID and transaction key empty to use the built-in stub gateway.
# Server-only: never prefix these with NEXT_PUBLIC_. Check them with `npm run payments:check`.
# On Vercel: sandbox keys in the Preview environment only; leave Production empty for now.
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
# Optional. Verifies webhook X-ANET-Signature (HMAC-SHA512); must be 128 hex characters when set.
AUTHORIZE_NET_SIGNATURE_KEY=
# sandbox (default) | production
AUTHORIZE_NET_ENV=
# Required with Authorize.net keys (payments are disabled without it): signs the customer
# profile id the browser holds, so a guessed id can't be charged. At least 32 characters.
# Generate with: openssl rand -hex 32   (a different value per Vercel environment)
PAYMENTS_SESSION_SECRET=
# production is REFUSED (payments disabled) unless this is 1. Do NOT set it until the go-live
# checklist in docs/payments.md is done: server-side bookings and amounts, real admin auth.
AUTHORIZE_NET_ALLOW_PRODUCTION=
# Fail closed: in production (NODE_ENV or VERCEL_ENV = production, which includes `next start`
# and Vercel production deploys) the stub is refused when the keys above are empty, and every
# payment route answers 503. Set to 1 only for a demo deployment that should use the stub.
PAYMENTS_ALLOW_STUB=
